  "functions": [
    {"match": "^(link|lnk)", "run": ["e2e_nle/test_clip_link*.py", "e2e_nle/test_diff_copy_kinds.py", "visual -k link_"], "note": "リンクしたクリップ"},
    {"match": "^ana", "run": ["e2e_nle/test_analysis*.py"], "note": "曲の解析の橋渡し"},
    {"match": "^review|^drawReviewMarks$", "run": ["e2e_misc/test_review.py"], "note": "審査の指摘"},
    {"match": "^(lib|_?loadNativeLibs|scanLibrary|saveLibDirs|addLibItem|renderLib|updateLibCat|ensureItemInfo|loadSongFromItem)|Media|AssetClip|^(scanAssetLibrary|saveClipToAsset|prepareMedia)",
     "run": ["e2e_nle/test_media*.py"], "note": "MEDIA"},
    {"match": "^(lane|setNoteLanes|resetLanes|packLanes|visLaneN|syncLaneSb|applyLaneVis|toggleLaneState|shiftLocks)", "run": ["e2e_nle/test_lanes.py", "e2e_nle/test_lane_default.py", "e2e_nle/test_edit_only.py"], "note": "レーン"},
    {"match": "[eE]ditOnly", "run": ["e2e_nle/test_edit_only.py", "visual -k edit_only"], "note": "単独編集"},
    {"match": "^(diff(Copy|Clear|Blank|Store|Opt|Counts|Col|Secs|IsCurrent)|stashCurrentDiff|switchDiffByIndex|loadDiff|ensureDiffSelect|renderDiffBar|openDiffMenu|initScratchDiff|_diffApplyLive|dispDiff|curDiffDn|dirDiff|updateDiffLabel)",
     "run": ["e2e_project/test_diff_ops.py", "e2e_nle/test_diff_copy_kinds.py", "e2e_project/test_empty_diff_place.py", "e2e_project/test_dirty_switch.py", "e2e/test_project.py"], "note": "難易度の切り替え・転送"},
    {"match": "^old", "run": ["e2e_project/test_old_formats.py"], "note": "古い形式のプロジェクト"},
    {"match": "^(rp[A-Z]|_rp|replay)|^(playViewStart|aTime|_tick|PV_MODES|pvNext)$",
     "run": ["e2e_misc/test_replay*.py", "e2e_misc/test_mode_labels.py", "e2e/test_place.py", "e2e_edit/test_edit_details.py", "e2e_nle/test_music.py"],
     "note": "REPLAY の窓（同期は再生の仕組みの _tick・play・pause に入っている＝再生のテストも回す）"},
    {"match": "^(drawReplay|RP_|fmtRp)|^updateHoverBox$",
     "run": ["e2e_misc/test_replay_marks.py", "unit_js/test_replay_marks.py", "e2e_misc/test_review.py", "e2e_edit/test_edit_details.py", "e2e_edit/test_note_props.py"],
     "note": "REPLAY の点を重ねる（NLE の印・3D の輪・ツールチップ。審査の指摘の ▼ と同じ帯。updateHoverBox は 3D のマウスの下の枠）"},
    {"match": "^(saveProject|saveProjectCopy|openProjectFile|newProject|applyProject|applyOpenedProject|buildProjectText|resetAllState|markSaved|confirmDiscard|rotateBakIdb|openFromNativeArg|restoreView|(enc|dec)(Sec|Diff|Arr)|_slimBase|sanitizeInfoGraph|idb|restoreLineAssets|songReconnect)",
